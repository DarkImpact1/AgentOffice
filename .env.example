# AgentOffice Environment Configuration
# Copy this file to .env and fill in your values

# ===================
# REQUIRED
# ===================

# Anthropic API Key (for LLM features)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Telegram Bot Token
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxx

# Your Telegram Chat ID (for notifications)
# Get from: https://t.me/userinfobot
TELEGRAM_CHAT_ID=your-chat-id

# ===================
# GOOGLE APIS
# ===================

# Path to Google OAuth credentials file
# Download from: https://console.cloud.google.com/apis/credentials
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Google Sheets ID (optional - for task sync)
GOOGLE_SHEETS_ID=

# ===================
# BROWSER AUTOMATION
# ===================

# Chrome profile path (for Tab Monitor & Freelance Hunter)
# Leave empty to use default profile
CHROME_PROFILE_PATH=

# ===================
# DATABASE
# ===================

# SQLite database path
DATABASE_PATH=./data/agent_office.db

# ===================
# LLM SETTINGS
# ===================

# Default model for simple tasks
DEFAULT_MODEL=claude-sonnet-4-20250514

# Complex model for advanced reasoning
COMPLEX_MODEL=claude-sonnet-4-20250514

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600

# ===================
# LOGGING
# ===================

LOG_LEVEL=INFO
